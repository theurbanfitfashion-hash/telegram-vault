# Public frontend variable: your independent Convex deployment URL
VITE_CONVEX_URL=https://precise-mongoose-576.ap-southeast-2.convex.cloud

# Convex deployment's HTTP actions origin (Convex sets this for deployed apps)
CONVEX_SITE_URL=https://precise-mongoose-576.ap-southeast-2.convex.site

# Local Convex CLI only; never commit real credentials
CONVEX_DEPLOYMENT=

# Server-side Convex environment variables (set with: npx convex env set NAME VALUE)
# SITE_URL=https://telegram-vault-web.onrender.com
# RESEND_API_KEY=re_...
# AUTH_EMAIL_FROM=Telegram Vault <login@your-verified-domain.com>
# AUTH_GOOGLE_ID=...
# AUTH_GOOGLE_SECRET=...
# TELEGRAM_BOT_TOKEN is optional; each user can instead connect their own bot in the UI.
